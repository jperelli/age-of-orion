diff --git a/src/rnd.c b/src/rnd.c
index 76ef6a6..9a9bfd1 100644
--- a/src/rnd.c
+++ b/src/rnd.c
@@ -1,5 +1,9 @@
 #include "config.h"
 
+#include <stdio.h>
+#include <stdlib.h>
+
+#define RND_NO_LOG_MACROS
 #include "rnd.h"
 #include "hw.h"
 #include "types.h"
@@ -57,6 +61,26 @@ uint16_t rnd_1_n(uint16_t n, uint32_t *seed)
     return 1 + rnd_0_nm1(n, seed);
 }
 
+uint32_t *rnd_log_seed = NULL;
+
+uint16_t rnd_0_nm1_log(uint16_t n, uint32_t *seed, const char *file, int line)
+{
+    static FILE *fd = NULL;
+    static int opened = 0;
+    uint16_t r = rnd_0_nm1(n, seed);
+    if (seed == rnd_log_seed) {
+        if (!opened) {
+            const char *path = getenv("OOM_HARNESS_RNGLOG");
+            opened = 1;
+            fd = path ? fopen(path, "w") : NULL;
+        }
+        if (fd) {
+            fprintf(fd, "%u %u %s:%d\n", (unsigned)n, (unsigned)r, file, line);
+        }
+    }
+    return r;
+}
+
 uint32_t rnd_get_new_seed(void)
 {
     uint32_t seed;
