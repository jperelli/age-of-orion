+/* Age of Orion comparison harness: log the calls made on one seed (the game's). */
+extern uint32_t *rnd_log_seed;
+extern uint16_t rnd_0_nm1_log(uint16_t n, uint32_t *seed, const char *file, int line);
+#ifndef RND_NO_LOG_MACROS
+#define rnd_0_nm1(n_, s_) rnd_0_nm1_log((n_), (s_), __FILE__, __LINE__)
+#define rnd_1_n(n_, s_) ((uint16_t)(1 + rnd_0_nm1_log((n_), (s_), __FILE__, __LINE__)))
+#endif
+
 #endif
